{
  "name": "@ethical-tech/pageturn-book-workspace",
  "version": "3.0.0",
  "description": "PageTurn Book V3 semantic reader, library, publication SDK, and reference application",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "compat/v2/packages/*",
    "tools/*",
    "apps/demo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build:fixture && npm run build:demo",
    "build:pages": "npm run build:packages && npm run build:fixture && npm run build:demo",
    "build:packages": "npm run build --workspace @ethical-tech/pageturn-book && tsc -b",
    "pack:sdk": "npm pack --workspace @ethical-tech/pageturn-book",
    "build:fixture": "node scripts/build-fixtures.mjs",
    "build:fixture:demo": "node tools/publication-cli/dist/cli.js build apps/fixtures/demo --out apps/demo/book --theme /src/demo.css --enhance-script /src/chapter.ts",
    "build:fixture:production": "node tools/publication-cli/dist/cli.js build apps/fixtures/what-is-ethical-ai --out apps/demo/book --theme /src/demo.css --enhance-script /src/chapter.ts",
    "build:demo": "vite build --config apps/demo/vite.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:sdk-consumer": "node scripts/verify-sdk-package.mjs",
    "test:browser": "playwright test",
    "check:pages": "node scripts/check-pages-build.mjs",
    "sync:production-fixture": "node scripts/sync-production-fixture.mjs",
    "sync:lab-publications": "node scripts/sync-lab-publications.mjs",
    "sync:field-guide-sourcebook": "node scripts/sync-field-guide-sourcebook.mjs",
    "sync:plurality": "node scripts/sync-plurality-fixture.mjs",
    "measure:v3-mobile": "node scripts/measure-v3-mobile.mjs",
    "preview:demo": "vite preview --config apps/demo/vite.config.ts --host 127.0.0.1 --port 4174"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
